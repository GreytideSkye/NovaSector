//April Fools Lovealand Disks//
/obj/item/disk/holodisk/LLintro
	preset_image_type = /datum/preset_holoimage/clown
	preset_record_text = {"
	NAME Greeting Clown
	DELAY 10
	SAY Welcome to the Revitalized Lovealand Experience!
	DELAY 20
	SAY Previous Lovealand Experiences were Too Freeform and caused Strife with a capital S.
	DELAY 20
	SAY So today, enjoy a mostly self-guided Lovealand Experience!
	DELAY 20
	SAY Contestants please step to the West and find your way into the Dressing Room.
	DELAY 40
	SAY The way West is is written on the ceiling.
	DELAY 40
	SAY No wait, that's where I left the word Gullible. Still: find West, Contestants!
	DELAY 40
	"}

/obj/item/disk/holodisk/LLaa
	preset_image_type = /datum/preset_holoimage/captain
	preset_record_text = {"
	NAME Narrator
	DELAY 10
	SAY Come, contestants, to the Dressing Room! The Loneliness Singularity is nearly upon us!
	DELAY 20
	SAY In the first stage, Pod Partners, contestants take one of two roles, in two groups.
	DELAY 20
	SAY The first group splits up into the escape pods, one each. You're the lucky first wave.
	DELAY 30
	SAY The second group uses the microphones on the back of the escape pods to converse with the people stuck inside the pods.
	DELAY 30
	SAY They want to find whoever they most want to spend possibly the rest of their short lives with, and then get in!
	DELAY 40
	SAY If two folk want in the same escape pod, fight over it.
	DELAY 40
	SAY Do not waste much time in the Dressing Room. You'll have costume changes and also the station is actively exploding in a Loneliness Singularity.
	DELAY 40
	SAY Pretend we have the budget for pyrotechnics.
	DELAY 40
	"}

/obj/item/disk/holodisk/LLab
	preset_image_type = /datum/preset_holoimage/captain
	preset_record_text = {"
	NAME Narrator
	DELAY 10
	SAY Come, contestants, get Dressing Roomed! The Loneliness Singularity is nearly upon us!
	DELAY 20
	SAY Six of you go out into the pods. It really does not matter who.
	DELAY 20
	SAY Then the rest of you fight over who gets to get in which pod.
	DELAY 30
	SAY When you're all settled, and some of you are dead and others escaping, push on the escape pod wall.
	DELAY 30
	SAY Again, pretend we have the budget for a lengthy escape sequence and CGI explosions.
	DELAY 30
	SAY At that point, you've crash landed on Lovealand! Open the door and proceed through.
	DELAY 40
	SAY And uh, if the one keypad does not work, try the one in the lobby.
	DELAY 40
	SAY Pretend we have the budget to understand how keypads work.
	DELAY 120
	"}

/obj/item/disk/holodisk/LLac
	preset_image_type = /datum/preset_holoimage/engineer
	preset_record_text = {"
	NAME Ashe Andust
	DELAY 10
	SAY Steal my keycard and suffer my curse!
	DELAY 20
	SAY I used to be a contestant, but I took too long getting dressed!
	DELAY 20
	SAY I was the hottest contestant. That keycard only belongs to hot people!
	DELAY 30
	"}

/obj/item/disk/holodisk/LLab
	preset_image_type = /datum/preset_holoimage/captain
	preset_record_text = {"
	NAME Narrator
	DELAY 10
	SAY Welcome to the Camp Anionship!
	DELAY 20
	SAY Stranded on a hostile planet, you quickly forage some shelter.
	DELAY 20
	SAY Time to tell ghost stories and get to know each other.
	DELAY 30
	SAY At the end of this exercise, if you want to swap partners, you are allowed. It is in the rules.
	DELAY 30
	SAY Again, pretend we have the budget for a lengthy escape sequence and CGI explosions.
	DELAY 30
	SAY Once you all are content with your pack bonding rituals, escape out the mineshaft in the back.
	DELAY 40
	SAY You might experience a change of heart.
	DELAY 40
	SAY If you do not, you may need to manually invoke one.
	DELAY 120
	"}
